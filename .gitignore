# File: .gitignore
# Purpose: What a build writes, and the files that survive a rule anyway.

#
# Normal rules (sorted alphabetically)
#
.*
*.disk
*.log
*.py[cod]
*.rs.bk
*.swp
*.swo
*~
\#*#

#
# Top-level generic files
#
/target/
/target-elf/

#
# These files should be kept even if they are dot-files.
#
!.cargo/
!.cargo/config.toml
!.gitattributes
!.gitignore
!.rustfmt.toml

#
# Editors and agents
#
__pycache__/

#
# Operating systems
#
.DS_Store
Thumbs.db
desktop.ini

#
# Files that are the product, not the output
#
!Cargo.lock
!rust-toolchain.toml
