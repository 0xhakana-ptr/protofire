#!/usr/bin/env sh
# File: scripts/hooks/commit-msg
# Purpose: git commit-msg hook — enforce the Protofire commit message rules.
#   Runs on every `git commit` (install once with
#   `ln -s ../../scripts/hooks/commit-msg .git/hooks/commit-msg`).
#   See docs/fmts/commits.md for the rationale.

set -eu

if [ "$#" -ne 1 ]; then
    echo "commit-msg: usage: $0 <commit-message-file>" >&2
    exit 1
fi

msg_file="$1"
[ -f "$msg_file" ] || { echo "commit-msg: not a file: $msg_file" >&2; exit 1; }

# Strip the editor template's comment block (lines whose first non-space char
# is '#').  `git commit -m` messages never contain those, so this is a no-op
# for scripted commits.
cleaned="$(sed '/^[[:space:]]*#/d' "$msg_file")"

subject="$(printf '%s\n' "$cleaned" | sed -n '1p')"

fail() {
    echo "commit-msg: rejected — $1" >&2
    echo "  See docs/fmts/commits.md." >&2
    exit 1
}

# 1. Subject line is present.
[ -n "$subject" ] || fail "empty subject line"

# 2. No leading/trailing whitespace on the subject.
trimmed="$(printf '%s' "$subject" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
[ "$subject" = "$trimmed" ] || fail "subject must not have leading/trailing whitespace"

# 3. Merge/Revert subjects are generated by git — exempt.
case "$subject" in
    "Merge "*|"Revert "*) exit 0 ;;
esac

# 4. No trailing period.
case "$subject" in
    *.) fail "subject must not end with a period" ;;
esac

# 5. Reject the useless generic one-word subjects (Linus's pet peeves).
case "$subject" in
    update|Update|fix|Fix|fixup|cleanup|Cleanup|typo|wip|WIP|Wip)
        fail "subject '$subject' carries no information — describe the change" ;;
esac

# 6. The subject is English, which for a title means ASCII.  `CONTRIBUTING.md`
#    asks for English everywhere a reader greps, and this is the one place the
#    request is mechanical.  A name in a trailer is not prose and is exempt
#    below; a subject is prose.
if printf '%s' "$subject" | LC_ALL=C grep -q '[^ -~]'; then
    fail "subject must be ASCII (write it in English, see CONTRIBUTING.md)"
fi

# 7. Subject length <= 72 characters.  Unconditional, now that step 6 has
#    refused every non-ASCII byte: the exemption this carried for a CJK subject
#    served a permission that no longer exists.
slen="$(printf '%s' "$subject" | wc -c)"
[ "$slen" -le 72 ] || fail "subject too long ($slen > 72 chars)"

# 8. The body is English too.  A trailer line is exempt because the name in
#    `Signed-off-by:` is a person's and some names have no ASCII spelling; the
#    role that trailer names is fixed by CONTRIBUTING.md.
if printf '%s\n' "$cleaned" | \
    awk 'NR > 1 && /[^ -~]/ && $0 !~ /^[[:alpha:]][[:alnum:]_-]*:/ {
            print "  body line " NR " has a non-ASCII byte" > "/dev/stderr"
            bad = 1
         }
         END { exit bad }'
then
    :
else
    fail "body has non-ASCII prose (write it in English, see CONTRIBUTING.md)"
fi

# 9. Body lines wrapped at 72 characters.  awk counts characters, so a line with
#    a non-ASCII byte in it is measured fairly.  Lines that look like git
#    trailers ("Co-authored-by: ...", "Signed-off-by: ...", ...) are exempt:
#    trailers stay on a single line and are produced by tooling, not wrapped by
#    hand.
if printf '%s\n' "$cleaned" | \
    awk 'NR > 1 && /./ && $0 !~ /^[[:alpha:]][[:alnum:]_-]*:/ && length($0) > 72 {
            print "  body line " NR " is " length($0) " chars (>72)" > "/dev/stderr"
            bad = 1
         }
         END { exit bad }'
then
    :
else
    fail "body has lines over 72 chars (see stderr)"
fi

# 10. Every commit carries a person's Signed-off-by (DCO).  This is the one
#     mandatory attribution trailer: people own the work, tools only assist
#     (see CONTRIBUTING.md for the three roles).
case "$cleaned" in
    *"Signed-off-by:"*) : ;;
    *) fail "missing Signed-off-by trailer (git commit -s)" ;;
esac

exit 0
